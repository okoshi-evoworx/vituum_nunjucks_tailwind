{
  "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-jinja-template"],
  "printWidth": 320,
  "singleAttributePerLine": false,
  "htmlWhitespaceSensitivity": "css",
  "vueIndentScriptAndStyle": false,
  "overrides": [
    {
      "files": "*.njk",
      "options": {
        "parser": "jinja-template"
      }
    }
  ]
}