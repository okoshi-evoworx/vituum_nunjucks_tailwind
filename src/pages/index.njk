{% extends 'templates/layout/base.njk' %}
{% block css -%}
{%- endblock %}
{% block js -%}
{%- endblock %}
{% block main -%}
  <h1 class="font-jp font-bold text-black">INDEX</h1>
  <div>
    <pre>{{ mode }}</pre>
    <pre>{{ page.path }}</pre>
  </div>
  <section id="section1">
    <h2>見出し</h2>
    <p>内容</p>
    <div class="c-sample animate-(--fade-in) hover:animate-(--fade-out)">.c-sample</div>
    <figure class="mr-auto ml-auto w-240 md:w-480">
      <img src="/src/img/src_sample.webp" alt="" width="640" height="640" loading="lazy" />
    </figure>
    <figure class="mt-24 mr-auto ml-auto w-240 md:mt-48 md:w-480">
      <img src="/img/public_sample.webp" alt="" width="640" height="640" loading="lazy" />
    </figure>
  </section>
  <section id="section2">
    <h2 class="text-lg font-bold">アコーディオン</h2>

    <details class="c-collapsible-panel is-open" open>
      <summary>
        <h3>タイトル</h3>
        <span class="icon"></span>
      </summary>
      <div class="wrapper">
        <div class="body">
          <p>内容</p>
        </div>
      </div>
    </details>
    <details class="c-collapsible-panel">
      <summary>
        <h3>タイトル</h3>
        <span class="icon"></span>
      </summary>
      <div class="wrapper">
        <div class="body">
          <p>内容</p>
        </div>
      </div>
    </details>
  </section>
  <section id="section3">
    <h2 class="text-lg font-bold">タブ</h2>
    <div class="c-tabs">
      <div role="tablist" aria-label="タブの名称">
        <button type="button" role="tab" aria-selected="true" aria-controls="a" id="tab-a" tabindex="0">タブA</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="b" id="tab-b" tabindex="-1">タブB</button>
      </div>
      <div>
        <!-- [role="tablist"]の nextElementSibling として必要 -->
        <div id="a" role="tabpanel" tabindex="0" aria-labelledby="tab-a">タブAコンテンツ</div>
        <div id="b" role="tabpanel" tabindex="0" aria-labelledby="tab-b" hidden>タブBコンテンツ</div>
      </div>
    </div>
  </section>
{%- endblock %}
